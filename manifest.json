{
  "manifest_version": 3,
  "name": "AI Chat Scroll",
  "version": "0.2",
  "description": "Bookmark and scroll to specific elements on any page.",
  "permissions": ["storage", "contextMenus", "activeTab"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "AI Chat Scroll",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/observer.js"],
      "run_at": "document_idle"
    }
  ]
}