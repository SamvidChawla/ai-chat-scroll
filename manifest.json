{
  "manifest_version": 3,
  "name": "AI Chat Scroll",
  "version": "0.1",
  "description": "Bookmark messages dynamically on any website",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/observer.js"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_title": "AI Chat Scroll"
  }
}
