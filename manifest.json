{
  "manifest_version": 3,
  "name": "AI Chat Scroll",
  "version": "0.3",
  "description": "Bookmark and scroll to specific elements on any page.",
  "permissions": ["storage", "contextMenus", "activeTab"],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "48": "logo.png"
  },
  "action": {
    "default_title": "AI Chat Scroll",
    "default_popup": "popup.html",
    "default_icon": "logo.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/observer.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}